# Required for accepted tickets
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Recommended fallback (if blank, fallback is disabled explicitly)
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b

# Optional web fallback when local RAG confidence is below 0.70
SERPER_API_KEY=
RAG_THRESHOLD=0.70
RETRIEVAL_TOP_K=4
RETRIEVAL_CANDIDATE_K=16
EMBEDDING_MODEL=en_core_web_lg

# Tuned hybrid-reranking weights. Keep the sum positive; evaluate changes offline.
SEMANTIC_WEIGHT=0.30
BM25_WEIGHT=0.26
RRF_WEIGHT=0.15
EXACT_CODE_WEIGHT=0.15
SOURCE_ROUTE_WEIGHT=0.10
FOCUS_TERM_WEIGHT=0.14

# Tracing is off by default. Only masked content reaches traces.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=secure-rcm-support

# Optional Google Sheets audit sink; otherwise JSONL mock logging is used.
GOOGLE_SHEET_ID=
GOOGLE_WORKSHEET=tickets
GOOGLE_SERVICE_ACCOUNT_FILE=
MOCK_LOG_FILE=runtime/ticket_events.jsonl
# Optional secret used to create stable, non-reversible audit contact references.
AUDIT_PSEUDONYM_KEY=

# Optional Gmail test workflow. OAuth and token files must stay gitignored.
GMAIL_OAUTH_CLIENT_FILE=gmail-oauth-client.json
GMAIL_TOKEN_FILE=gmail-token.json
GMAIL_SUPPORT_ADDRESS=
GMAIL_SUBJECT_PREFIX=[RCM TEST]
GMAIL_MAX_MESSAGES=3
GMAIL_PROCESSED_LABEL=RCM-Processed
GMAIL_REJECTED_LABEL=RCM-Rejected
GMAIL_PENDING_LABEL=RCM-Pending-Review

MAX_CONCURRENCY=5
AUTO_APPROVE=true
REIDENTIFY_PERSON_NAMES=false

# Configure from your current provider contract; zero avoids stale pricing claims.
INPUT_COST_PER_MILLION=0
OUTPUT_COST_PER_MILLION=0

# Disable third-party CrewAI telemetry for the sensitive-data reference profile.
CREWAI_TELEMETRY_OPT_OUT=true

